# Delta Exchange Testnet / Demo Credentials
# Get these from Delta Exchange Demo -> Profile -> API Management
DELTA_API_KEY=your_delta_demo_api_key_here
DELTA_API_SECRET=your_delta_demo_api_secret_here

# Base URL for Delta Demo / Testnet:
# For India Testnet: https://cdn-ind.testnet.deltaex.org
# For Global Testnet: https://testnet-api.delta.exchange
DELTA_BASE_URL=https://cdn-ind.testnet.deltaex.org

# Secret passphrase to secure your TradingView webhook against unauthorized requests
WEBHOOK_PASSPHRASE=create_a_strong_random_secret_passphrase_here

# Default contract symbol (e.g., BTCUSD)
DEFAULT_SYMBOL=BTCUSD

# Default lot/contract size per trade
DEFAULT_ORDER_SIZE=1

# Execution Mode:
# 'reversal'  -> BUY closes any short & opens long; SELL closes any long & opens short
# 'long_only' -> BUY opens long; SELL only closes the long position (no shorting)
EXECUTION_MODE=reversal

# Signal Inversion Mode (Contrarian):
# true  -> Indicator BUY triggers SELL order; Indicator SELL triggers BUY order
# false -> Indicator BUY triggers BUY order; Indicator SELL triggers SELL order
INVERT_SIGNALS=true

# Server Port (Render sets this automatically via PORT env var)
PORT=8000
